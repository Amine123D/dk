rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }
    function isGroupMember(groupId) {
      return signedIn() &&
        firestore.exists(/databases/(default)/documents/groups/$(groupId)/members/$(request.auth.uid));
    }
    match /items/{groupId}/{uid}/{fileName} {
      allow read: if isGroupMember(groupId);
      allow create, update: if isGroupMember(groupId)
        && request.auth.uid == uid
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if signedIn() && request.auth.uid == uid && isGroupMember(groupId);
    }
  }
}