rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isMember(groupId) {
      return signedIn() && exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));
    }
    function isAdmin(groupId) {
      return isMember(groupId) &&
        get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.role == 'admin';
    }
    match /users/{uid} {
      allow create: if signedIn() && request.auth.uid == uid;
      allow read, update, delete: if signedIn() && request.auth.uid == uid;
    }
    match /groups/{groupId} {
      allow read: if isMember(groupId);
      allow create: if signedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if isAdmin(groupId);
      match /members/{memberId} {
        allow read: if isMember(groupId);
        allow create: if signedIn() && (
          (memberId == request.auth.uid && request.resource.data.uid == request.auth.uid) || isAdmin(groupId)
        );
        allow update: if isAdmin(groupId);
        allow delete: if signedIn() && (memberId == request.auth.uid || isAdmin(groupId));
      }
    }
    match /items/{itemId} {
      // Listings are visible only to members of the private group they belong to.
      allow read: if signedIn() && isMember(resource.data.groupId);
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.groupId is string
        && isMember(request.resource.data.groupId)
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 2
        && request.resource.data.title.size() <= 70
        && request.resource.data.imageUrls is list
        && request.resource.data.imageUrls.size() <= 4;
      allow update: if signedIn()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.groupId == resource.data.groupId
        && isMember(resource.data.groupId);
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }
    match /loanRequests/{id} {
      allow create: if signedIn() && request.resource.data.borrowerId == request.auth.uid;
      allow read: if signedIn() && (resource.data.borrowerId == request.auth.uid || resource.data.ownerId == request.auth.uid);
      allow update: if signedIn() && (resource.data.borrowerId == request.auth.uid || resource.data.ownerId == request.auth.uid);
      allow delete: if false;
    }
    match /ratings/{id} {
      allow create: if signedIn() && request.resource.data.fromUserId == request.auth.uid;
      allow read: if signedIn();
      allow update, delete: if false;
    }
    match /notifications/{id} {
      allow read, update, delete: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
    }
    match /reports/{id} {
      allow create: if signedIn() && request.resource.data.reporterId == request.auth.uid;
      allow read, update, delete: if false;
    }
  }
}